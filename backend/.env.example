PORT=4000
JWT_SECRET=cambia-esta-clave-en-produccion
JWT_EXPIRA_SEG=86400
BCRYPT_ROUNDS=10

# Conexion local a PostgreSQL (usada si DATABASE_URL no esta definida)
PGHOST=localhost
PGPORT=5432
PGDATABASE=vivemonterrico
PGUSER=postgres
PGPASSWORD=postgres

# Alternativa para proveedores en la nube (Neon, Supabase, Render, etc.):
# si se define, esta cadena manda sobre las variables PG* de arriba.
# DATABASE_URL=postgresql://usuario:clave@host/basededatos
# PGSSL=true

URL_BASE=http://localhost:4000
CORS_ORIGEN=*
